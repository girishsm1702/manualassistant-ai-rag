# Copy this file to .env and fill in values. Never commit .env.

DJANGO_SECRET_KEY=change-me-in-local-env
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# sqlite is the default local database. PostgreSQL + pgvector can be wired later.
DATABASE_URL=sqlite:///db.sqlite3
# When Docker pgvector is running:
# DATABASE_URL=postgresql://manuals:manuals@127.0.0.1:5432/manuals

# Embedding model downloaded once into the Hugging Face cache.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.35
VECTOR_WEIGHT=0.65
KEYWORD_WEIGHT=0.35
OCR_ENABLED=true

# Optional LLM. Leave blank to use the extractive grounded generator (no API key).
# Example for a local OpenAI-compatible server or Ollama:
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=llama3.2
# LLM_API_KEY=ollama
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
